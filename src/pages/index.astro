---
import { getEmDashCollection, getSiteSettings } from "emdash";
import { Image } from "emdash/ui";
import Base from "../layouts/Base.astro";
import { resolveStarterSiteIdentity } from "../utils/site-identity";
import FadeInText from "@astroanimate/core/FadeInText";

const { entries: posts, cacheHint } = await getEmDashCollection("posts", {
	limit: 3,
	orderBy: { published_at: "desc" },
});
const { siteTitle, siteTagline } = resolveStarterSiteIdentity(await getSiteSettings());
Astro.cache.set(cacheHint);
---

<Base title={siteTitle} description={siteTagline}>
	<section class="hero">
		<div class="frame media-frame">
			<video
				class="frame-video"
				autoplay
				muted
				loop
				playsinline
				poster="/hero-poster.png"
			>
				<source src="/hero.mp4" type="video/mp4" />
			</video>
			<div class="frame-copy">
				<FadeInText enhance yOffset={20} once>
				<h1>{siteTitle}</h1>
				</FadeInText>
				{siteTagline && <p>{siteTagline}</p>}
			</div>
		</div>
	</section>

	<section class="recent">
		<div class="recent-head">
			<h2 class="page-heading">Recent posts</h2>
			<a class="all-posts" href="/posts">All posts</a>
		</div>

		{
			posts.length === 0 ? (
				<p class="empty">
					No posts yet.{" "}
					<a href="/_emdash/admin/content/posts/new">Create one</a>.
				</p>
			) : (
				<ul class="post-list">
					{posts.map((post) => (
						<li class="post-card">
							<a class="card-link" href={`/posts/${post.id}`}>
								{post.data.featured_image && (
									<Image image={post.data.featured_image} />
								)}
								<h2>{post.data.title}</h2>
							</a>
							{post.data.excerpt && <p class="excerpt">{post.data.excerpt}</p>}
							{post.data.publishedAt && (
								<time class="meta" datetime={post.data.publishedAt.toISOString()}>
									{post.data.publishedAt.toLocaleDateString("en-US", {
										year: "numeric",
										month: "long",
										day: "numeric",
									})}
								</time>
							)}
						</li>
					))}
				</ul>
			)
		}
	</section>
</Base>

<style>
	.hero {
		display: grid;
		place-items: center;
		min-height: calc(100svh - 8rem);
		padding: var(--space-4) 0 var(--space-6);
	}

	.frame {
		position: relative;
		width: min(60rem, 100%);
		aspect-ratio: 16 / 9;
	}

	.frame-video {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.frame-copy {
		position: relative;
		z-index: 1;
		height: 100%;
		display: grid;
		align-content: end;
		padding: var(--space-5);
		background: linear-gradient(
			to top,
			rgb(7 16 24 / 0.88) 0%,
			rgb(7 16 24 / 0.35) 45%,
			transparent 70%
		);
	}

	.frame-copy h1 {
		margin: 0;
		font-size: clamp(2.25rem, 6vw, 3.75rem);
		color: var(--text);
		text-shadow: 0 2px 24px rgb(7 16 24 / 0.8);
	}

	.frame-copy p {
		margin: var(--space-2) 0 0;
		max-width: 36ch;
		color: var(--muted);
		font-family: var(--font-display);
		font-size: 1.05rem;
	}

	@media (prefers-reduced-motion: reduce) {
		.frame-video {
			display: none;
		}
	}

	.recent {
		padding-top: var(--space-5);
	}

	.recent-head {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--space-3);
		margin-bottom: var(--space-5);
	}

	.recent-head .page-heading {
		margin: 0;
	}

	.all-posts {
		font-family: var(--font-display);
		font-size: 0.9rem;
		text-decoration: none;
	}

	.empty {
		color: var(--muted);
	}
</style>
